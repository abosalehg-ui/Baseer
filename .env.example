# ============================================
# بَصير | Baseer — قالب متغيرات البيئة
# انسخ هذا الملف إلى .env وعدّل القيم
# ============================================

# مسارات التخزين
BASEER_DATA_DIR=./data
BASEER_MODELS_DIR=./models
BASEER_DB_PATH=./data/results.duckdb

# تكامل CVAT (بدون بادئة — تُقرأ بواسطة CvatSettings)
# ملاحظة: التطبيق يفتح CVAT في المتصفح فقط ولا يستخدم بيانات الاعتماد برمجياً.
# لا تضع كلمة مرور حقيقية هنا؛ عند إضافة تكامل REST مستقبلاً ستُنقل إلى keyring.
CVAT_URL=http://localhost:8080
CVAT_USERNAME=admin

# CUDA
BASEER_CUDA_DEVICE=0

# سجلات التشغيل
BASEER_LOG_LEVEL=INFO
BASEER_LOG_FILE=./logs/baseer.log

# إعدادات الواجهة
# dark أو light — يُطبَّق فعلياً على كل التطبيق (QSS + الرسوم + لوحة الرسم)
BASEER_UI_THEME=dark
BASEER_UI_LANGUAGE=ar

# الخصوصية والتصدير
# ملح تجهيل أرقام اللوحات عند التصدير (HMAC-SHA256).
# ⚠️ **لا تترك القيمة الافتراضية**: فضاء اللوحة السعودية صغير (≈10⁷)، فمن يعرف
# الملح يعكس كل رموز PLATE-XXXXXXXXXX في ثوانٍ. التطبيق يولّد ملحاً عشوائياً
# ويكتبه في `.env` عند أول تشغيل إن كانت القيمة هي الافتراضية؛ أو عيّنه بنفسك:
#     python -c "import secrets; print(secrets.token_hex(16))"
# تغييره يفصل رموز دراسة عن أخرى (الرمز ثابت لنفس اللوحة داخل الدراسة).
BASEER_ANON_SALT=baseer-default-salt

# خط PDF العربي — يُستخدم إن أردت خطاً غير المُرفَق في assets/fonts/
BASEER_PDF_FONT=
